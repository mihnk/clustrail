---
// Shared SVG symbols, referenced with <use href="#…">. Status glyphs use a
// distinct shape per state so color is never the only signal.
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="s-ok" viewBox="0 0 12 12">
      <circle cx="6" cy="6" r="4" fill="currentColor"></circle>
    </symbol>
    <symbol id="s-err" viewBox="0 0 12 12">
      <path d="M4 .8h4L11.2 4v4L8 11.2H4L.8 8V4z" fill="currentColor"></path>
      <path
        d="M4.2 4.2l3.6 3.6M7.8 4.2L4.2 7.8"
        style="stroke:var(--bg)"
        stroke-width="1.5"
        stroke-linecap="round"
      ></path>
    </symbol>
    <symbol id="s-warn" viewBox="0 0 12 12">
      <path d="M6 .9l5.4 9.8H.6z" fill="currentColor"></path>
      <path
        d="M6 4.4v2.8"
        style="stroke:var(--bg)"
        stroke-width="1.4"
        stroke-linecap="round"
      ></path>
    </symbol>
    <symbol id="s-pend" viewBox="0 0 12 12">
      <circle cx="6" cy="6" r="4.4" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <path d="M6 1.6a4.4 4.4 0 0 1 0 8.8z" fill="currentColor"></path>
    </symbol>
    <symbol id="i-gh" viewBox="0 0 24 24">
      <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path>
    </symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24">
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </symbol>
    <symbol id="i-lock" viewBox="0 0 24 24">
      <rect x="5" y="11" width="14" height="9" rx="2"></rect>
      <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
    </symbol>
    <symbol id="i-eye" viewBox="0 0 24 24">
      <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </symbol>
    <symbol id="i-shield" viewBox="0 0 24 24">
      <path d="M12 3l8 3v6c0 5-3.5 8.2-8 9.5C7.5 20.2 4 17 4 12V6z"></path>
    </symbol>
    <symbol id="i-layers" viewBox="0 0 24 24">
      <path d="M12 3l9 5-9 5-9-5z"></path>
      <path d="M3 13l9 5 9-5"></path>
    </symbol>
    <symbol id="i-logs" viewBox="0 0 24 24">
      <path d="M4 6h16M4 10h16M4 14h11M4 18h7"></path>
    </symbol>
    <symbol id="i-term" viewBox="0 0 24 24">
      <rect x="2.5" y="4" width="19" height="16" rx="3"></rect>
      <path d="M7 9l3 3-3 3M12.5 15.5h4.5"></path>
    </symbol>
    <symbol id="i-code" viewBox="0 0 24 24">
      <path d="M8 7l-5 5 5 5M16 7l5 5-5 5"></path>
    </symbol>
    <symbol id="i-scale" viewBox="0 0 24 24">
      <path d="M3 12h18M7 8l-4 4 4 4M17 8l4 4-4 4"></path>
    </symbol>
    <symbol id="i-helm" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="3.5"></circle>
      <circle cx="12" cy="12" r="8"></circle>
      <path d="M12 2v5M12 17v5M2 12h5M17 12h5"></path>
    </symbol>
    <symbol id="i-git" viewBox="0 0 24 24">
      <circle cx="7" cy="5" r="2.2"></circle>
      <circle cx="7" cy="19" r="2.2"></circle>
      <circle cx="17" cy="8" r="2.2"></circle>
      <path d="M7 7.2v9.6M17 10.2c0 4.5-10 2.8-10 6.6"></path>
    </symbol>
    <symbol id="i-node" viewBox="0 0 24 24">
      <rect x="3" y="4" width="18" height="7" rx="1.5"></rect>
      <rect x="3" y="13" width="18" height="7" rx="1.5"></rect>
      <path d="M7 7.5h.01M7 16.5h.01"></path>
    </symbol>
    <symbol id="i-trail" viewBox="0 0 24 24">
      <path d="M17 5H10L5 10V14L10 19H17"></path>
    </symbol>
    <symbol id="i-home" viewBox="0 0 24 24">
      <path d="M3 11l9-8 9 8v10H3z"></path>
      <path d="M9.5 21v-6h5v6"></path>
    </symbol>
    <symbol id="i-user-x" viewBox="0 0 24 24">
      <circle cx="9.5" cy="8" r="3.8"></circle>
      <path d="M2.5 20c0-3.8 3.2-6 7-6s7 2.2 7 6M17 5l5 5M22 5l-5 5"></path>
    </symbol>
    <symbol id="i-key" viewBox="0 0 24 24">
      <circle cx="8" cy="15.5" r="4.5"></circle>
      <path d="M11.2 12.3L20 3.5M17 6.5l3 3"></path>
    </symbol>
    <symbol id="i-x" viewBox="0 0 24 24">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </symbol>
    <symbol id="i-check" viewBox="0 0 24 24">
      <path d="M5 12.5l4.5 4.5L19 7"></path>
    </symbol>
    <symbol id="i-route" viewBox="0 0 24 24">
      <circle cx="6" cy="19" r="2.5"></circle>
      <circle cx="18" cy="5" r="2.5"></circle>
      <path d="M8.5 19H16a3.5 3.5 0 0 0 0-7H8a3.5 3.5 0 0 1 0-7h7.5"></path>
    </symbol>
    <symbol id="i-net" viewBox="0 0 24 24">
      <rect x="9" y="2.5" width="6" height="5" rx="1"></rect>
      <rect x="2.5" y="16.5" width="6" height="5" rx="1"></rect>
      <rect x="15.5" y="16.5" width="6" height="5" rx="1"></rect>
      <path d="M12 7.5v4.5M5.5 16.5V14a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v2.5"></path>
    </symbol>
    <symbol id="i-disk" viewBox="0 0 24 24">
      <ellipse cx="12" cy="5.5" rx="8" ry="3"></ellipse>
      <path d="M4 5.5v13c0 1.7 3.6 3 8 3s8-1.3 8-3v-13M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"></path>
    </symbol>
    <symbol id="i-alert" viewBox="0 0 24 24">
      <path d="M12 3.5l9.5 16.5h-19z"></path>
      <path d="M12 10v4M12 17h.01"></path>
    </symbol>
  </defs>
</svg>
