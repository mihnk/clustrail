---

<div class="shot" role="img" aria-label={label}>
  <div class="win" aria-hidden="true">
    <div class="tb">
      <div class="dots">
        <i style="background:#FF5F57"></i>
        <i style="background:#FEBC2E"></i>
        <i style="background:#28C840"></i>
      </div>
      <svg width="18" height="18" viewBox="0 0 64 64">
        <rect width="64" height="64" rx="14.5" fill="#13252A"></rect>
        <path
          d="M45 17H27L17 27V37L27 47H45"
          fill="none"
          stroke="#3CC4D0"
          stroke-width="9.5"
          stroke-linejoin="round"
          stroke-linecap="round"
        ></path>
        <circle cx="47" cy="47" r="7.4" fill="#F1F5F7" stroke="#13252A" stroke-width="2.6"></circle>
      </svg>
      <span class="wt on">
        Pods <span class="mono t-mute small">3 clusters</span>
      </span>
      <span class="wt">Logs · checkout-api</span>
      <span class="wt">
        <svg class="s t-err">
          <use href="#s-err"></use>
        </svg>
        Investigation
      </span>
      <span class="grow"></span>
      <span class="chip search">
        Go to resource or run command…<span class="grow"></span>
        <span class="kbd">⌘K</span>
      </span>
    </div>
    <div class="bd">
      <div class="side">
        <span class="h">Clusters</span>
        <span class="c grp">
          <span class="tag tag-prod mini">PROD</span>Production
          <svg class="ic t-prod lock">
            <use href="#i-lock"></use>
          </svg>
        </span>
        <span class="c">
          <i class="cb"></i>prod-eu-west-1
        </span>
        <span class="c">
          <i class="cb"></i>prod-us-east-1
        </span>
        <span class="c grp">
          <span class="tag tag-stg mini">STG</span>Staging
        </span>
        <span class="c">
          <i class="cb"></i>staging-eu-1
        </span>
        <span class="c dim">
          <i class="cb off"></i>staging-perf
        </span>
        <span class="h gap">Resources</span>
        <span class="n on">
          Pods<span class="pill">7</span>
        </span>
        <span class="n">Deployments</span>
        <span class="n">Services</span>
        <span class="n">Events</span>
        <span class="n">Nodes</span>
      </div>
      <div class="tbl">
        <div class="vh">
          <b>Pods</b>
          <span class="chip">
            <i class="sq"></i>prod-eu-west-1
          </span>
          <span class="chip">
            <i class="sq"></i>prod-us-east-1
          </span>
          <span class="chip">
            <i class="di"></i>staging-eu-1
          </span>
        </div>
        <div class="r hd">
          <span>Status</span>
          <span>Name</span>
          <span>Cluster</span>
          <span class="num">Ready</span>
          <span class="num">Restarts</span>
          <span class="num">Age</span>
        </div>
        {rows.map((r, i) => (
          <div class:list={['r', { sel: i === 0 }]}>
            <span class={`st ${r[2]}`}>
              <svg class="s">
                <use href={`#${r[1]}`} />
              </svg>
              {r[0]}
            </span>
            <span class="nm">{r[3]}</span>
            <span>
              <i class={r[4]} /> {r[5]}
            </span>
            <span class={`num ${r[7]}`}>{r[6]}</span>
            <span class={`num ${r[9]}`}>{r[8]}</span>
            <span class="num">{r[10]}</span>
          </div>
        ))}
      </div>
      <div class="insp">
        <span class="meta">
          Pod <span class="tag tag-prod mini">PROD</span>
          <span class="t-prod prot">
            <svg class="ic small-ic">
              <use href="#i-lock"></use>
            </svg>
            Protected
          </span>
        </span>
        <b class="mono podname">checkout-api-7d9f8b6c4-x2kqp</b>
        <div class="alert">
          <b>
            <span class="t-err">CrashLoopBackOff</span> · container api
          </b>
          <span class="muted">Last terminated OOMKilled (exit 137) · 14 restarts</span>
        </div>
        <div class="mini-btns">
          <span class="mb">Logs</span>
          <span class="mb">Shell</span>
          <span class="mb">Owner</span>
          <span class="mb lock-btn">
            <svg class="ic small-ic">
              <use href="#i-lock"></use>
            </svg>
            Modify
          </span>
        </div>
        <span class="h ev-h">Latest events</span>
        <div class="ev">
          <svg class="s t-warn">
            <use href="#s-warn"></use>
          </svg>
          <span>
            <b>BackOff</b> <span class="muted">restarting failed container api</span>
          </span>
          <span class="mono t-mute">×42</span>
        </div>
        <div class="ev">
          <svg class="s t-warn">
            <use href="#s-warn"></use>
          </svg>
          <span>
            <b>Unhealthy</b> <span class="muted">readiness probe HTTP 503</span>
          </span>
          <span class="mono t-mute">×9</span>
        </div>
        <span class="grow"></span>
        <span class="mb cta">Investigate checkout-api</span>
      </div>
    </div>
    <div class="sb">
      <span>● 3/3 connected</span>
      <span class="mono">prod-eu-west-1 38ms · prod-us-east-1 112ms · staging-eu-1 64ms</span>
      <span class="grow"></span>
      <span class="t-prod">2 production clusters protected</span>
    </div>
  </div>
</div>

<style>
  .shot {
    margin-top: 36px;
    overflow-x: auto;
    border-radius: 14px;
    box-shadow: var(--shadow);
  }
  .win {
    /* Scrolls sideways on narrow screens rather than squeezing the table. */
    min-width: 1040px;
    border: 1px solid var(--line-2);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg);
    font-size: 12.5px;
    line-height: 1.4;
  }
  .grow {
    flex: 1;
  }
  .small {
    font-size: 10.5px;
  }
  .tb {
    height: 38px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 12px;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
  }
  .dots {
    display: flex;
    gap: 7px;
  }
  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: block;
  }
  .wt {
    height: 26px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 9px;
    border-radius: 6px;
    color: var(--fg-2);
    font-weight: 500;
  }
  .wt.on {
    background: var(--elev);
    color: var(--fg);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .kbd {
    font: 500 10.5px/1 var(--mono);
    padding: 3px 5px;
    border: 1px solid var(--line-2);
    border-bottom-width: 2px;
    border-radius: 4px;
    color: var(--fg-3);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 20px;
    padding: 0 7px;
    border-radius: 5px;
    border: 1px solid var(--line);
    background: var(--elev);
    font-size: 11.5px;
    color: var(--fg-2);
  }
  .chip.search {
    width: 230px;
    height: 24px;
  }
  .bd {
    display: grid;
    grid-template-columns: 186px minmax(0, 1fr) 300px;
    height: 420px;
  }
  .side {
    background: var(--bg-2);
    border-right: 1px solid var(--line);
    padding: 10px 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .h {
    font: 600 10.5px/1 var(--font);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-3);
    padding: 8px 8px 6px;
  }
  .h.gap {
    padding-top: 14px;
  }
  .side .c {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 24px;
    padding: 0 8px;
    border-radius: 5px;
    color: var(--fg);
  }
  .side .c.grp {
    color: var(--fg-3);
    font-size: 11px;
    gap: 6px;
  }
  .side .c.dim {
    color: var(--fg-2);
  }
  .tag.mini {
    height: 16px;
    font-size: 9.5px;
  }
  .lock {
    width: 12px;
    height: 12px;
    margin-left: auto;
  }
  .side .n {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 25px;
    padding: 0 8px;
    border-radius: 5px;
    color: var(--fg-2);
  }
  .side .n.on {
    background: var(--elev);
    color: var(--fg);
    font-weight: 500;
  }
  .pill {
    margin-left: auto;
    font: 600 10px/1 var(--mono);
    padding: 3px 5px;
    border-radius: 4px;
    color: var(--err);
    background: color-mix(in srgb, var(--err) 16%, transparent);
  }
  .tbl {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .vh {
    height: 42px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    border-bottom: 1px solid var(--line);
  }
  .vh b {
    font-size: 14px;
  }
  .r {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr) 108px 38px 46px 34px;
    column-gap: 8px;
    align-items: center;
    height: 27px;
    padding: 0 12px;
    border-bottom: 1px solid var(--line);
    color: var(--fg-2);
    white-space: nowrap;
  }
  .r.hd {
    height: 28px;
    font-size: 11px;
    color: var(--fg-3);
    font-weight: 500;
  }
  .r.sel {
    background: var(--accent-soft);
    color: var(--fg);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .nm {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .num {
    text-align: right;
    font-family: var(--mono);
    font-size: 11.5px;
  }
  .st {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    font-size: 11.5px;
  }
  .insp {
    border-left: 1px solid var(--line);
    background: var(--panel);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .meta {
    display: flex;
    gap: 6px;
    align-items: center;
    font-size: 11.5px;
    color: var(--fg-3);
  }
  .prot {
    display: flex;
    gap: 4px;
    align-items: center;
  }
  .small-ic {
    width: 12px;
    height: 12px;
  }
  .podname {
    font-size: 13px;
  }
  .alert {
    background: color-mix(in srgb, var(--err) 12%, transparent);
    border-radius: 8px;
    padding: 9px 10px;
    font-size: 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .mini-btns {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .mb {
    height: 24px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0 8px;
    border-radius: 5px;
    border: 1px solid var(--line-2);
    font-size: 11.5px;
    color: var(--fg);
    background: var(--elev);
  }
  .mb.lock-btn {
    border-style: dashed;
    background: transparent;
    color: var(--fg-3);
  }
  .mb.cta {
    justify-content: center;
    height: 30px;
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
    font-weight: 500;
  }
  .ev-h {
    padding: 4px 0 0;
  }
  .ev {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr) auto;
    gap: 8px;
    font-size: 11.5px;
    padding: 6px 0;
    border-top: 1px solid var(--line);
    align-items: start;
  }
  .sb {
    height: 24px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 12px;
    background: var(--bg-2);
    border-top: 1px solid var(--line);
    font-size: 11px;
    color: var(--fg-3);
  }
</style>
