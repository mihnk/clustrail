---
// A static picture of the app (sample data), drawn in HTML so it stays sharp
// and follows the theme. The window content is the app's own English UI.
interface Props {
  label: string;
}
const { label } = Astro.props;

type Row = [
  status: string,
  glyph: string,
  tone: string,
  name: string,
  env: 'sq' | 'di',
  cluster: string,
  ready: string,
  readyTone: string,
  restarts: string,
  restartsTone: string,
  age: string,
];
const rows: Row[] = [
  [
    'CrashLoop',
    's-err',
    't-err',
    'checkout-api-7d9f8b6c4-x2kqp',
    'sq',
    'prod-eu-west-1',
    '1/2',
    't-warn',
    '14',
    't-err',
    '3d',
  ],
  [
    'CrashLoop',
    's-err',
    't-err',
    'checkout-api-7d9f8b6c4-m8vtn',
    'sq',
    'prod-eu-west-1',
    '1/2',
    't-warn',
    '11',
    't-err',
    '3d',
  ],
  [
    'ImagePull',
    's-err',
    't-err',
    'ledger-sync-5b6d9c7f8-q4wzr',
    'di',
    'staging-eu-1',
    '0/1',
    't-warn',
    '0',
    '',
    '12m',
  ],
  [
    'Pending',
